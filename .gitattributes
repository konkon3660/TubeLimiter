# Normalise line endings across the repository.
# Git decides what is text, stores it with LF, and checks it out with LF.
* text=auto eol=lf

# Binary assets: never run any line-ending or diff filter over them.
*.png binary
*.jar binary
*.jks binary
*.keystore binary
*.zip binary

# The Gradle wrapper scripts need fixed endings regardless of platform.
gradlew text eol=lf
gradlew.bat text eol=crlf
