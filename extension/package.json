{
  "name": "tubelimiter-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs --zip",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"public/**/*.{html,css,json}\" build.mjs eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"public/**/*.{html,css,json}\" build.mjs eslint.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
